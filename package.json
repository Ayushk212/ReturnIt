{
  "name": "returnit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ReturnIt — Lost & Found Web Platform",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "prebuild": "npm run build:shared",
    "build:shared": "npm run build -w shared",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspaces --if-present",
    "e2e": "playwright test",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "predb:migrate": "npm run build:shared",
    "db:migrate": "npm run db:migrate -w backend",
    "api:dev": "npm run dev -w backend",
    "web:dev": "npm run dev -w frontend"
  },
  "overrides": {
    "tinypool": "^2.2.0",
    "braces": "^3.0.3"
  },
  "dependencies": {
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2"
  }
}
