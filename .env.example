# ==============================================================================
# ReturnIt — Environment Configuration (.env.example)
# Copy this file to .env and fill in real values. Never commit .env files.
# ==============================================================================

# Node environment ('development' | 'production' | 'test')
NODE_ENV=development

# API service
PORT=5050
API_HOST=0.0.0.0

# PostgreSQL on Neon (Dashboard → Connection details). Contains a password: keep it secret.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full

# Neon Auth base URL (Neon Console → Auth). Used to verify sign-in tokens.
NEON_AUTH_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth

# Comma-separated list of web origins allowed to call the API
CORS_ORIGIN=http://localhost:5185

# Rate limiting (per signed-in session, or per IP for anonymous requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ------------------------------------------------------------------------------
# Web app (Vite). Put these in frontend/.env. Values here are exposed to browsers,
# so never place secrets in VITE_ variables.
# ------------------------------------------------------------------------------
VITE_USE_MOCK=false            # true = run on built-in demo data, no backend needed
VITE_API_URL=http://localhost:5050/api
VITE_SOCKET_URL=http://localhost:5050
VITE_NEON_AUTH_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
