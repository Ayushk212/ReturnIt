# ==============================================================================
# ReturnIt — Environment Configuration (.env.example)
# Copy this file to .env and populate with appropriate values.
# Do NOT commit actual secrets to version control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# API Service Configuration
PORT=5000
API_HOST=0.0.0.0

# Database (Single-node replica set for Mongo transactions)
# Local: mongodb://localhost:27017/returnit?replicaSet=rs0&directConnection=true
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/returnit
MONGODB_URI=mongodb://localhost:27017/returnit?replicaSet=rs0&directConnection=true

# CORS & Client Integration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Firebase Admin Configuration (Backend)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Authentication & JWT Secrets
# Generate high-entropy strings (e.g., openssl rand -base64 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# Media & Storage (Cloudinary signed uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Client (Vite) Environment Variables
VITE_USE_MOCK=false            # true = run on built-in demo data, no backend needed
VITE_API_URL=http://localhost:5000/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_SOCKET_URL=http://localhost:5000
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
